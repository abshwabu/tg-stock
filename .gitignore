# Root .gitignore for Inventory monorepo

# Built deployment zip archives
/dist/
*.zip

# Server ignored files
/server/vendor/
/server/.env
/server/.env.*
!/server/.env.example
/server/.phpunit.result.cache
/server/.phpunit.cache/
/server/storage/*.key
/server/storage/logs/*.log
/server/database/*.sqlite
/server/database/*.sqlite-journal
/server/public/storage
/server/public/hot

# Console ignored files
/console/vendor/
/console/.env
/console/.env.*
!/console/.env.example
/console/.phpunit.result.cache
/console/.phpunit.cache/
/console/storage/*.key
/console/storage/logs/*.log
/console/database/*.sqlite
/console/database/*.sqlite-journal
/console/public/storage
/console/public/hot

# App Flutter ignored files
/app/.dart_tool/
/app/.flutter-plugins
/app/.flutter-plugins-dependencies
/app/build/
/app/.packages
/app/.pub-cache/
/app/.pub/

# Android Signing Keys and Keystores (Strictly ignored)
*.jks
*.keystore
key.properties
/app/android/key.properties

# Explicitly ensure lockfiles are committed
!/server/composer.lock
!/console/composer.lock
!/app/pubspec.lock

# IDE & Editor artifacts
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Native shared library binaries
*.so
/scripts/ext/
